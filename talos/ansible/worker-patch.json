{
  "machine": {
    "kubelet": {
      "extraMounts": [
        {
          "destination": "/var/lib/iscsi",
          "type": "bind",
          "source": "/var/lib/iscsi",
          "options": [
            "bind",
            "rshared",
            "rw"
          ]
        },
        {
          "destination": "/var/lib/longhorn",
          "type": "bind",
          "source": "/var/lib/longhorn",
          "options": [
            "bind",
            "rshared",
            "rw"
          ]
        }
      ]
    }
  }
}